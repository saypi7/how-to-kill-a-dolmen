{
  "name": "dino-extinction-battle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:backend": "cd backend && go run .",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "cd backend && go run .",
    "test:server": "cd backend && go test ./...",
    "test:race": "cd backend && go test -race ./...",
    "test:client": "node --experimental-strip-types --test",
    "test": "npm run test:client && npm run test:server",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "format:css": "prettier --write \"src/**/*.css\"",
    "format:css:check": "prettier --check \"src/**/*.css\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
