{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "의존성 설치",
      "dependsOn": ["npm 설치", "Go 모듈 설치"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "npm 설치",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["install"],
      "problemMatcher": []
    },
    {
      "label": "Go 모듈 설치",
      "type": "shell",
      "command": "go",
      "args": ["mod", "download"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "프런트엔드",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev"],
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Go 서버",
      "type": "shell",
      "command": "go",
      "args": ["run", "."],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "개발 서버 둘 다 시작",
      "dependsOn": ["프런트엔드", "Go 서버"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "프런트 빌드",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "서버 테스트",
      "type": "shell",
      "command": "go",
      "args": ["test", "./..."],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
